<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.ems.department.model.mapper.DepartmentMapper">
    <select id="selectAll" resultType="com.kh.ems.department.model.dto.Department">
        SELECT 
            DEPT_ID as deptId,
            DEPT_TITLE as deptTitle,
            LOCATION_ID as locationId
        FROM DEPARTMENT
    </select>
</mapper>
